{
    "manifest_version": 3,
    "name": "ScrapTab",
    "version": "1",
    "description": "Your tiny scrapbook for the internet",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": ["storage", "contextMenus", "activeTab", "notifications", "alarms"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["browser-polyfill-min.js", "storage.js", "content.js"]
    }]
}
