{
    "manifest_version": 3,
    "name": "ScrapTab",
    "version": "0.1",
    "description": "Your tiny scrapbook for the internet",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": ["storage", "contextMenus", "activeTab"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["browser-polyfill.js", "content.js", "storage.js"]
    }]
}

